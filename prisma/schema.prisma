generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ===========================================================================
// AUTH.JS  (identity/session only; domain attribution lives on Employee)
// ===========================================================================

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ===========================================================================
// REFERENCE DATA  (one-way: Airtable -> Postgres; read-only in the app)
// ===========================================================================

model Employee {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  airtableId     String?  @unique @map("airtable_id")
  name           String
  email          String?  @unique
  team           String? // ← Airtable "Creative Team (Editors)": Content Production Video | Marketing Video | Organic Social Video | Design
  division       String? // ← Airtable "MV Entity"
  isTeamLead     Boolean  @default(false) @map("is_team_lead")
  employmentType String   @default("employee") @map("employment_type") // ← Airtable "Employment Status"
  active         Boolean  @default(true) // ← Airtable "Active Status": Active | Not Active
  roles          String[] @default([]) // ← Airtable "Roles" (multiselect): app access roles (Editor, Manager, Admin, …)
  capacity       Int? // ← Airtable "Capacity" (number): weighted load = 100%; blank → global default
  syncedAt       DateTime @default(now()) @map("synced_at") @db.Timestamptz

  assetTypeTeamLeads        AssetTypeTeamLead[]        @relation("AssetTypeTeamLead")
  assetTypePreferredEditors AssetTypePreferredEditor[] @relation("AssetTypePreferredEditor")
  assignedTickets           Ticket[]                   @relation("TicketAssignee")
  requestedTickets          Ticket[]                   @relation("TicketRequester")
  ticketEvents              TicketEvent[]
  approvals                 Approval[]
  contentSources            ContentSource[]            @relation("ContentSourceCreatedBy")
  mowSlots                  MowSlot[]
  performanceAttributions   PerformanceAttribution[]
  learnings                 Learning[]
  briefs                    Brief[]
  experiments               Experiment[]

  @@map("employees")
}

model Dimension {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  airtableId String?  @unique @map("airtable_id")
  label      String // e.g. "9x16" — ← Airtable "Name" field
  syncedAt   DateTime @default(now()) @map("synced_at") @db.Timestamptz

  assetTypes AssetTypeDimension[]

  @@map("dimensions")
}

model EventType {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  airtableId     String?  @unique @map("airtable_id")
  name           String // e.g. Masterclass, Mastery, States, MBU, Social Media Promotion, Pathway
  brainProgramId String?  @map("brain_program_id") // [VERIFY] link to Mindvalley Brain
  active         Boolean  @default(true)
  loadWeight     Float?   @map("load_weight") // ← Airtable "Load Weight": capacity cost/ticket; blank → 1
  tierNorm       Float?   @map("tier_norm") // ← Airtable "Tier Norm" (0–1): priority event tier
  syncedAt       DateTime @default(now()) @map("synced_at") @db.Timestamptz

  assetTypes AssetTypeEventType[]
  tickets    Ticket[]

  @@map("event_types")
}

model Dna {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  airtableId        String?  @unique @map("airtable_id")
  name              String
  requirements      String?
  feedbackStandards String?  @map("feedback_standards")
  syncedAt          DateTime @default(now()) @map("synced_at") @db.Timestamptz

  assetTypes AssetType[]

  @@map("dna")
}

model AssetType {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  airtableId        String? @unique @map("airtable_id")
  name              String // e.g. "Masterclass Trailer"
  fullName          String? @map("full_name") // ← Airtable "Asset Type (Full title)": fallback when short name is blank
  category          String? // ← Airtable "Type of Asset": Print | Digital
  creativeCategory  String? @map("creative_category") // ← Airtable "Category": Creative Video/Brand Design/Event Design Type
  dnaId             String? @map("dna_id") @db.Uuid // legacy; DNA is dormant (text fields below are the live source, E9.7)
  active            Boolean @default(true) // ← Airtable "Status": Active | Inactive
  loadWeight        Float?  @map("load_weight") // ← Airtable "Load Weight": capacity cost/ticket; blank → 1
  effortNorm        Float?  @map("effort_norm") // ← Airtable "Effort Norm" (0–1): priority complexity effort
  dnaRequirements   String? @map("dna_requirements") // ← Airtable "DNA / Requirements" (E9.7)
  feedbackStandards String? @map("feedback_standards") // ← Airtable "Feedback Standards" (E9.7)
  dnaUpdatedBy      String? @map("dna_updated_by") // ← Airtable "DNA Updated By": last portal editor email

  // Upstream DNA, READ-ONLY from Airtable's synced source (added 2026-09-08). The
  // portal-owned pair above wins when non-empty; otherwise these are the review baseline.
  // Precedence lives in lib/dna-review/config.ts so the two interfaces can't diverge.
  dnaUpstream       String? @map("dna_upstream") // ← Airtable "DNA" (72/118 populated)
  viralityDna       String? @map("virality_dna") // ← Airtable "Video/Virality DNA"
  dnaLink           String? @map("dna_link") // ← Airtable "DNA link" (url)
  processDnaUrl     String? @map("process_dna_url") // ← Airtable "Process DNA" (url)
  processDnaSummary String? @map("process_dna_summary") // ← Airtable "URL Summary (Process DNA)" (aiText)

  // Work emails allowed to RAISE this asset type on the intake form, resolved from
  // Airtable's "Stakeholder" link at sync time. Stored as emails rather than a join table:
  // the linked records live in a second employees roster the app doesn't mirror, so their
  // recIds can never resolve locally. Empty array = no restriction (fail open).
  stakeholderEmails String[] @default([]) @map("stakeholder_emails")
  syncedAt          DateTime @default(now()) @map("synced_at") @db.Timestamptz

  dna Dna? @relation(fields: [dnaId], references: [id])

  // Airtable models these as MULTIPLE record links → many-to-many (reconciliation 2026-06-25)
  eventTypes       AssetTypeEventType[]
  teamLeads        AssetTypeTeamLead[]
  preferredEditors AssetTypePreferredEditor[]

  dimensions     AssetTypeDimension[]
  tickets        Ticket[]
  dnaReviewRules DnaReviewRule[]

  @@map("asset_types")
}

model AssetTypeDimension {
  assetTypeId String @map("asset_type_id") @db.Uuid
  dimensionId String @map("dimension_id") @db.Uuid

  assetType AssetType @relation(fields: [assetTypeId], references: [id], onDelete: Cascade)
  dimension Dimension @relation(fields: [dimensionId], references: [id], onDelete: Cascade)

  @@id([assetTypeId, dimensionId])
  @@map("asset_type_dimensions")
}

// Asset type ↔ event type (Airtable "Event Type" multi-link)
model AssetTypeEventType {
  assetTypeId String @map("asset_type_id") @db.Uuid
  eventTypeId String @map("event_type_id") @db.Uuid

  assetType AssetType @relation(fields: [assetTypeId], references: [id], onDelete: Cascade)
  eventType EventType @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)

  @@id([assetTypeId, eventTypeId])
  @@map("asset_type_event_types")
}

// Asset type ↔ team lead employees (Airtable "Team Lead" multi-link)
model AssetTypeTeamLead {
  assetTypeId String @map("asset_type_id") @db.Uuid
  employeeId  String @map("employee_id") @db.Uuid

  assetType AssetType @relation(fields: [assetTypeId], references: [id], onDelete: Cascade)
  employee  Employee  @relation("AssetTypeTeamLead", fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([assetTypeId, employeeId])
  @@map("asset_type_team_leads")
}

// Asset type ↔ preferred editor employees (Airtable "Preferred Editors" multi-link)
model AssetTypePreferredEditor {
  assetTypeId String @map("asset_type_id") @db.Uuid
  employeeId  String @map("employee_id") @db.Uuid

  assetType AssetType @relation(fields: [assetTypeId], references: [id], onDelete: Cascade)
  employee  Employee  @relation("AssetTypePreferredEditor", fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([assetTypeId, employeeId])
  @@map("asset_type_preferred_editors")
}

// Contractors / freelancers — the second assignable pool (alongside Employee
// creatives). Reference: one-way Airtable → PG; edited in Airtable.
model Contractor {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  airtableId   String?  @unique @map("airtable_id")
  name         String
  active       Boolean  @default(true) // ← Airtable "Status": Active | …
  serviceLevel String?  @map("service_level") // ← Airtable "Team/Service Level"
  capacity     Int? // ← Airtable "Capacity" (number)
  syncedAt     DateTime @default(now()) @map("synced_at") @db.Timestamptz

  @@map("contractors")
}

// ⚙️ Scoring Config — app-owned global knobs (key→number). Mirrored one-way from
// Airtable for fast reads; edited at /settings/scoring (writes still go to Airtable,
// mirror refreshes). Per-type weights live on EventType/AssetType; per-person
// capacity on Employee/Contractor.
model ScoringConfigKnob {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  airtableId String?  @unique @map("airtable_id")
  key        String // stable config key (e.g. w_due, default_capacity)
  value      Float? // the numeric knob value
  label      String? // admin-panel label
  group      String? // Capacity | Priority weights | Thresholds
  note       String?
  updatedBy  String?  @map("updated_by")
  syncedAt   DateTime @default(now()) @map("synced_at") @db.Timestamptz

  @@map("scoring_config")
}

// 🧠 Clip Rules — editable clip-generation prompt/pillars/rules. Mirrored one-way
// from Airtable for fast reads; edited at /settings/clip-rules (writes go to Airtable).
model ClipRule {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  airtableId        String?  @unique @map("airtable_id")
  name              String?
  kind              String? // Base Prompt | Brand Pillars | Rule
  clipType          String?  @map("clip_type") // All | Reel | Stage Talk | Short
  content           String?
  active            Boolean  @default(true)
  order             Int? // sort for appended rules
  section           String? // General | Clips | Thumbnail | Titles | Distribution
  note              String?
  updatedBy         String?  @map("updated_by")
  airtableUpdatedAt String?  @map("airtable_updated_at") // ← Airtable "Last Modified" string (display/sort)
  createdTime       String?  @map("created_time") // ← Airtable createdTime (display/sort)
  syncedAt          DateTime @default(now()) @map("synced_at") @db.Timestamptz

  @@map("clip_rules")
}

// ===========================================================================
// TRANSACTIONAL DATA  (two-way: app is primary, pushed back to Airtable)
// ===========================================================================

model Ticket {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  airtableId    String?   @unique @map("airtable_id")
  title         String // renamed from "Summary" for Dropbox searchability
  creativeBrief String?   @map("creative_brief")
  cta           String? // ← Airtable "Call to action"
  positioning   String? // messaging angle
  audience      String? // 'cold' | 'warm'
  dueDate       DateTime? @map("due_date") @db.Date

  // Is the due date real? 'fixed' (externally committed, cannot move) | 'target' (we want
  // it by then) | 'evergreen' (no real deadline). Damps the deadline term in the queue
  // blend — see certaintyFactor() in lib/tickets/scoring.ts. Without this a star rating is
  // decoration: an item rated 2 that launches Monday still gets done before a 5 that never
  // truly ships. Null (legacy rows) is treated as 'target'.
  dateCertainty String? @map("date_certainty")

  eventTypeId        String? @map("event_type_id") @db.Uuid
  assetTypeId        String? @map("asset_type_id") @db.Uuid
  assigneeId         String? @map("assignee_id") @db.Uuid // ← Airtable "Assigned Creative"
  requesterId        String? @map("requester_id") @db.Uuid // ← Airtable "Requested By" (drives downstream lookups)
  officialCalendarId String? @map("official_calendar_id") @db.Uuid // ← Airtable "Official Calendar"

  // Attribution snapshot: the assignee's name as it was when the ticket was assigned.
  // The FK alone can't be trusted to answer "who edited this" — Airtable link cells blank
  // out when the linked 👬 Employees row is deleted (HR-sync offboarding), and that blank
  // used to propagate into `assignee_id` on the next reconcile. Read paths fall back here.
  assigneeName String? @map("assignee_name")

  teamServiceLevel String? @map("team_service_level") // ← "Team/Service Level"
  typeOfRequest    String? @map("type_of_request") // ← "Type of Request": Video | Design
  sourceLinks      String? @map("source_links") // ← "Raw File/Source URL/Stage Talk Links"
  downloadLink     String? @map("download_link") // ← editor download link (e.g. Dropbox) — E9.1
  notes            String? // ← "V's Notes"
  projectProgram   String? @map("project_program") // ← "Project/Program" (detail form)

  // Delivery links — discrete Prio fields the detail form edits directly (1:1 with Airtable,
  // so the two-way sync maps them field↔field). Distinct from the derived `assets` rows.
  assetFolderLink String? @map("asset_folder_link")
  workingFiles    String? @map("working_files")
  final16x9       String? @map("final_16x9")
  folder16x9      String? @map("folder_16x9")
  final9x16       String? @map("final_9x16")
  folder9x16      String? @map("folder_9x16")
  final4x5        String? @map("final_4x5")
  folder4x5       String? @map("folder_4x5")

  // Dedupe flag for the "asset ready" Slack notification (moved off the Airtable
  // "Asset Ready Notified" checkbox now that PG is the write source of truth).
  assetReadyNotified Boolean @default(false) @map("asset_ready_notified")

  // Two status axes (live values from reconciliation 2026-06-25):
  prioStatus   String? @map("prio_status") // New Request | To be reviewed by Vishen | In Queue | Pending Information/Brief Not Clear | Rejected - No need to work | Assigned
  ticketStatus String? @map("ticket_status") // Backlog | To Do | In Progress | Final Pass | Review | Feedback Given | In Revision | Approved | Done | Won't Do | Shipping | Published | Request on Hold (Final Pass added 2026-09-01, editor polishing an accepted auto-editing-agent draft — E12)

  urgency       Int?
  complexity    Int?
  priorityScore Decimal? @map("priority_score") @db.Decimal // derived; ranks the queue
  queueRank     Int?     @map("queue_rank") // ← Airtable "Priority ranking (Manual)"

  source           String    @default("app") // app | jira_migration | airtable
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  syncedAt         DateTime? @map("synced_at") @db.Timestamptz
  // Last time the app pushed this ticket to Airtable — echo-suppression window for
  // the (future) Phase 3 pull, so our own write doesn't ping-pong back.
  airtablePushedAt DateTime? @map("airtable_pushed_at") @db.Timestamptz

  eventType        EventType?        @relation(fields: [eventTypeId], references: [id])
  assetType        AssetType?        @relation(fields: [assetTypeId], references: [id])
  assignee         Employee?         @relation("TicketAssignee", fields: [assigneeId], references: [id])
  requester        Employee?         @relation("TicketRequester", fields: [requesterId], references: [id])
  officialCalendar OfficialCalendar? @relation(fields: [officialCalendarId], references: [id])

  events    TicketEvent[]
  approvals Approval[]
  shoots    ShootTicket[]
  assets    Asset[]
  authors   TicketAuthor[]

  clipSuggestions ClipSuggestion[] @relation("TicketClipSuggestions")

  dnaReviews           DnaReview[]
  dnaReviewRuleSources DnaReviewRule[] @relation("DnaRuleSourceTicket")

  performanceSnapshots AssetPerformanceSnapshot[]
  creativeRecords      CreativeRecord[]

  @@index([priorityScore(sort: Desc), queueRank], map: "idx_tickets_queue")
  @@index([assigneeId], map: "idx_tickets_assignee")
  @@index([ticketStatus], map: "idx_tickets_status")
  @@map("tickets")
}

// Phase 2 — outbox for two-way PUSH (portal → Airtable). Writes enqueue a row in the
// same transaction; a background drainer (drainOutbox) pushes current state to the
// target Airtable table, batched + rate-limited. We enqueue by (entity, entityId) —
// not a field snapshot — so the drainer always sends the latest state and collapses
// rapid successive edits.
//
// POLYMORPHIC (0012): `entity` names the domain ('ticket' | 'shoot' | 'social' | …)
// and `entityId` is that domain's internal PG id (uuid-as-text) or a domain key.
// The drainer dispatches on `entity` via lib/airtable/push-registry.ts. `ticketId`
// is retained (nullable) for in-flight rows enqueued before the migration; the
// drainer falls back to it when `entityId` is null (legacy 'ticket' rows).
model AirtableOutbox {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entity      String    @default("ticket") // domain discriminator → push-registry key
  entityId    String?   @map("entity_id") // internal PG id (text) of the domain row; null only on legacy rows
  ticketId    String?   @map("ticket_id") @db.Uuid // DEPRECATED: legacy fallback for pre-0012 rows
  op          String    @default("upsert") // upsert (create-or-update) | delete
  status      String    @default("pending") // pending | done | error
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  enqueuedAt  DateTime  @default(now()) @map("enqueued_at") @db.Timestamptz
  processedAt DateTime? @map("processed_at") @db.Timestamptz

  @@index([status, enqueuedAt], map: "idx_outbox_pending")
  @@index([entity, entityId], map: "idx_outbox_entity")
  @@map("airtable_outbox")
}

model TicketEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId  String?  @map("ticket_id") @db.Uuid
  fromState String?  @map("from_state")
  toState   String   @map("to_state")
  actorId   String?  @map("actor_id") @db.Uuid
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  ticket Ticket?   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  Employee? @relation(fields: [actorId], references: [id])

  @@map("ticket_events")
}

model Approval {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId   String?   @map("ticket_id") @db.Uuid
  approverId String?   @map("approver_id") @db.Uuid
  state      String    @default("pending") // pending | approved | changes_requested
  feedback   String?
  decidedAt  DateTime? @map("decided_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  ticket   Ticket?   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  approver Employee? @relation(fields: [approverId], references: [id])

  @@map("approvals")
}

// Shoots — pre-production filming requests. PG system-of-record with two-way Airtable
// sync (SHOOTS_BACKEND). Link fields (requester/authors/event types/asset-library/tickets)
// are stored as Airtable recId arrays — the shoot's OWN state is authoritative here; the
// drainer pushes these back to Airtable as link arrays. `notes`/`location` columns are
// reused (from the original reference model) as brief/filmingLocation. `shoot_date` column
// is legacy/dead (superseded by filming_date text).
model Shoot {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  airtableId        String?   @unique @map("airtable_id")
  title             String?
  status            String? // New Requests - Approved/Needs Review | To Film | Done - Filmed | Cancelled
  format            String?
  filmingDate       String?   @map("filming_date") // raw Airtable "Filming Date" string
  filmingLocation   String?   @map("location") // reuse legacy `location` column
  brief             String?   @map("notes") // reuse legacy `notes` column (Airtable notes)
  productionSupport String?   @map("production_support")
  vishenApproved    Boolean   @default(false) @map("vishen_approved")
  priorityRanking   Int?      @map("priority_ranking")
  rawFiles          String?   @map("raw_files")
  platforms         String[]  @default([])
  newPrioTicket     Boolean   @default(false) @map("new_prio_ticket")
  requestedById     String?   @map("requested_by_id") // Airtable Employee recId
  authorIds         String[]  @default([]) @map("author_ids")
  eventTypeIds      String[]  @default([]) @map("event_type_ids")
  assetTypeIds      String[]  @default([]) @map("asset_type_ids") // "Creative Asset Type" link (set at create; round-tripped, not read into ShootRow)
  assetLibraryIds   String[]  @default([]) @map("asset_library_ids")
  ticketIds         String[]  @default([]) @map("ticket_ids")
  createdTime       String?   @map("created_time") // Airtable createdTime (list ordering)
  airtablePushedAt  DateTime? @map("airtable_pushed_at") @db.Timestamptz // echo-suppression window
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  syncedAt          DateTime  @default(now()) @map("synced_at") @db.Timestamptz

  tickets ShootTicket[]

  @@index([airtablePushedAt], map: "idx_shoots_pushed")
  @@map("shoots")
}

model ShootTicket {
  shootId  String @map("shoot_id") @db.Uuid
  ticketId String @map("ticket_id") @db.Uuid

  shoot  Shoot  @relation(fields: [shootId], references: [id], onDelete: Cascade)
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@id([shootId, ticketId])
  @@map("shoot_tickets")
}

model Asset {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  airtableId      String?   @unique @map("airtable_id")
  ticketId        String?   @map("ticket_id") @db.Uuid
  kind            String // 'raw' | 'final'
  name            String? // asset title (library imports have no ticket to name them)
  sourceTable     String?   @map("source_table") // provenance: which Airtable table/origin this asset came from
  fileUrl         String?   @map("file_url") // Dropbox / storage link
  distributionUrl String?   @map("distribution_url") // link to social media calendar entry
  publishedAt     DateTime? @map("published_at") @db.Timestamptz
  syncedAt        DateTime  @default(now()) @map("synced_at") @db.Timestamptz

  ticket      Ticket?       @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  performance Performance[]

  @@map("assets")
}

model Performance {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId    String?  @map("asset_id") @db.Uuid
  metric     String // e.g. CTR, views, spend, ROAS
  value      Decimal? @db.Decimal
  capturedAt DateTime @default(now()) @map("captured_at") @db.Timestamptz
  source     String? // e.g. Clarisights, Amplitude, manual

  asset Asset? @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("performance")
}

// Official Calendar (reference, synced from Airtable) — campaign start/end dates.
model OfficialCalendar {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  airtableId String?   @unique @map("airtable_id")
  name       String // ← "Name of project"
  status     String? // Proposal | Confirmed | Completed | …
  startDate  DateTime? @map("start_date") @db.Date
  endDate    DateTime? @map("end_date") @db.Date
  syncedAt   DateTime  @default(now()) @map("synced_at") @db.Timestamptz

  tickets Ticket[]

  @@map("official_calendar")
}

// Authors / speakers (reference, synced from Airtable).
model Author {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  airtableId String?  @unique @map("airtable_id")
  name       String
  title      String? // ← "Author's Title"
  syncedAt   DateTime @default(now()) @map("synced_at") @db.Timestamptz

  tickets TicketAuthor[]

  @@map("authors")
}

// Ticket ↔ authors/speakers (Airtable "Speakers/Authors" multi-link).
model TicketAuthor {
  ticketId String @map("ticket_id") @db.Uuid
  authorId String @map("author_id") @db.Uuid

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([ticketId, authorId])
  @@map("ticket_authors")
}

// 📣 Social — Marketing content board (Content & Comms base). PG system-of-record with
// two-way Airtable sync (SOCIAL_BACKEND). Only the app-managed fields live here; other
// columns on the Airtable row (social format, content type, transcript, shoots link) are
// left untouched by the drainer. `creativeTicketId` is a Creative Services ticket recId
// stored as text (cross-base — can't be an Airtable link); `officialCalId` is a same-base
// link to CommsCalendar (recId).
model SocialPost {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  airtableId       String?   @unique @map("airtable_id")
  title            String?
  notes            String?
  captions         String?
  status           String? // 1: Proposal | 2: Approved | 2A. Ticket Raised | 13: Reject
  clipSourceUrl    String?   @map("clip_source_url") // engine-origin marker + grouping key
  sourceTitle      String?   @map("source_title")
  viralityScore    Int?      @map("virality_score")
  timecode         String?
  creativeTicketId String?   @map("creative_ticket_id") // Creative Services ticket recId (text; presence ⇒ raised)
  officialCalId    String?   @map("official_cal_id") // Content & Comms calendar recId (same-base link)
  createdTime      String?   @map("created_time")
  airtablePushedAt DateTime? @map("airtable_pushed_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  syncedAt         DateTime  @default(now()) @map("synced_at") @db.Timestamptz

  @@index([airtablePushedAt], map: "idx_social_pushed")
  @@map("social_posts")
}

// 📺 Media Sources — the media inbox (app-owned, Creative Services base). READ-MIRROR:
// PG is a fast read replica (MEDIA_BACKEND); writes still go to Airtable (createMediaSource/
// updateMediaSource, incl. the vishen-sync cross-base fan-out) and are write-through-upserted
// here, plus a pull catches external edits. No outbox — Airtable stays the source of truth.
// Link fields are kept as Airtable recId arrays/scalars. Clip Suggestions are NOT mirrored.
model MediaSource {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  airtableId               String?  @unique @map("airtable_id")
  title                    String?
  sourceUrl                String?  @map("source_url")
  downloadUrl              String?  @map("download_url")
  platform                 String?
  status                   String?
  guestShow                String?  @map("guest_show")
  audience                 String?
  submittedVia             String?  @map("submitted_via")
  usedWebSearch            Boolean  @default(false) @map("used_web_search")
  strategyJson             String?  @map("strategy_json")
  transcript               String?
  error                    String?
  submittedDate            String?  @map("submitted_date")
  clipsAddedDate           String?  @map("clips_added_date")
  clipSuggestionIds        String[] @default([]) @map("clip_suggestion_ids")
  submittedById            String?  @map("submitted_by_id")
  ticketEventTypeId        String?  @map("ticket_event_type_id")
  ticketAssetTypeId        String?  @map("ticket_asset_type_id")
  ticketOfficialCalendarId String?  @map("ticket_official_calendar_id")
  ticketDueDate            String?  @map("ticket_due_date")
  sourceRecordId           String?  @map("source_record_id")
  createdTime              String?  @map("created_time")
  syncedAt                 DateTime @default(now()) @map("synced_at") @db.Timestamptz

  @@map("media_sources")
}

// 🎬 Vishen's Videos — his complete cross-channel content log (team-maintained by hand).
// PG system-of-record with two-way Airtable sync (VISHEN_VIDEOS_BACKEND). The team edits most
// fields in Airtable (pulled in); the portal writes back ONLY approval/rating/views24h on an
// explicit tap (loop-safe — no inbound automation reads them, Status is never written), so the
// push-map touches only those three fields. `stage`/`channel` are derived in code, not stored.
model VishenVideo {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  airtableId       String?   @unique @map("airtable_id")
  name             String?
  source           String? // producer/agency
  medium           String?
  format           String?
  product          String?
  status           String? // 6-stage pipeline (read-only from the app)
  approval         String? // Vishen's sign-off (app writes)
  publishedLink    String?   @map("published_link")
  liveDate         String?   @map("live_date")
  /// Who set the Live Date from the portal, and when. The portal writes this ONE field on this
  /// table (AB4); everything else here is team-maintained and read-only to the app.
  liveDateSetBy    String?   @map("live_date_set_by")
  liveDateSetAt    DateTime? @map("live_date_set_at") @db.Timestamptz
  rating           Int? // 1–5 (app writes)
  views24h         String?   @map("views_24h") // team-logged 24h perf (app writes)
  createdTime      String?   @map("created_time")
  airtablePushedAt DateTime? @map("airtable_pushed_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  syncedAt         DateTime  @default(now()) @map("synced_at") @db.Timestamptz

  @@index([airtablePushedAt], map: "idx_vishen_videos_pushed")
  @@map("vishen_videos")
}

// 📅 Official Cal in the Content & Comms base (COMMS_OFFICIAL_CAL, tbl3PkmIprAMhU4AI) —
// one row per *project*. Distinct from OfficialCalendar (Creative Services) above, and from
// CommsDay (the day-level 🗓️ Comms Calendar) below.
//
// Renamed from `CommsCalendar` on 2026-09-09: the old name said "comms calendar" but
// `mapCommsCalendar` has always populated it from Official Cal, which made it look as though the
// day-level calendar was already synced when it wasn't. The DB table keeps its original name, so
// this rename is code-only — no DDL, no data movement.
//
// Reference: one-way Airtable → PG; edited in Airtable. Powers the /social/new calendar picker.
model OfficialCalCC {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  airtableId String?  @unique @map("airtable_id")
  name       String
  status     String?
  startDate  String?  @map("start_date") // raw Airtable date string (display/sort)
  endDate    String?  @map("end_date")
  syncedAt   DateTime @default(now()) @map("synced_at") @db.Timestamptz

  @@map("comms_calendars")
}

// ===========================================================================
// AI CONTENT CLIPPING ENGINE (E8)
// Transcript → 10-section viral strategy → selectable clips → proposed tickets.
// ===========================================================================

// One long-form transcript + the context it was generated with.
model ContentSource {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String
  sourceType    String   @map("source_type") // paste | file | youtube
  sourceUrl     String?  @map("source_url")
  guestName     String?  @map("guest_name")
  guestAudience String?  @map("guest_audience")
  brandPillars  String?  @map("brand_pillars")
  transcript    String   @db.Text
  createdById   String?  @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  createdBy  Employee?      @relation("ContentSourceCreatedBy", fields: [createdById], references: [id])
  strategies ClipStrategy[]

  @@map("content_sources")
}

// One generation run: the full 10-section strategy lives in `output` (JSON).
model ClipStrategy {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contentSourceId String   @map("content_source_id") @db.Uuid
  model           String
  status          String   @default("generating") // generating | complete | error
  error           String?
  output          Json?
  usedWebSearch   Boolean  @default(false) @map("used_web_search")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  contentSource ContentSource    @relation(fields: [contentSourceId], references: [id], onDelete: Cascade)
  clips         ClipSuggestion[]

  @@index([contentSourceId], map: "idx_clip_strategies_source")
  @@map("clip_strategies")
}

// The Reels clips, broken out for propose → approve → ticket tracking.
model ClipSuggestion {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clipStrategyId String  @map("clip_strategy_id") @db.Uuid
  index          Int
  title          String
  timestampStart String? @map("timestamp_start")
  timestampEnd   String? @map("timestamp_end")
  rationale      String?
  caption        String?
  hookLine       String? @map("hook_line")
  format         String?
  platform       String?
  viralityScore  Int?    @map("virality_score")
  status         String  @default("proposed") // proposed | approved | dismissed
  ticketId       String? @map("ticket_id") @db.Uuid

  clipStrategy ClipStrategy @relation(fields: [clipStrategyId], references: [id], onDelete: Cascade)
  ticket       Ticket?      @relation("TicketClipSuggestions", fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([clipStrategyId], map: "idx_clip_suggestions_strategy")
  @@map("clip_suggestions")
}

// ===========================================================================
// AI-ASSISTED DNA FEEDBACK (E13)
// A first-pass AI review of a ticket against its asset type's DNA, plus a learned
// rulebook layered on top of AssetType.dnaRequirements/feedbackStandards (the
// authored baseline). Postgres-native (no Airtable mirror) — this data cites
// Ticket/AssetType evidence that's already Postgres-primary. See
// prd/content-production-management/dna-feedback/technical-design.md.
// ===========================================================================

// The learned rulebook — one row per rule, scoped to an AssetType. Structurally the
// analog of ClipRule.kind === 'Rule' rows, but richer (statement/rationale/example/
// weight/confidence) to match the reference design this ports (BlinkLife's Recorder
// Review Skills rule schema). Proposals land `active: false` pending approval.
model DnaReviewRule {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetTypeId    String   @map("asset_type_id") @db.Uuid
  statement      String // imperative, <200 chars — the rule itself
  rationale      String? // why it matters
  example        String? // concrete example or quoted evidence
  weight         Int      @default(3) // 1-5, importance
  confidence     Float    @default(0.5) // 0-1
  active         Boolean  @default(false) // proposals land inactive; approval flips true
  source         String // 'tier1_decision' | 'tier1_reaction' | 'tier2_proposal' | 'manual'
  sourceTicketId String?  @map("source_ticket_id") @db.Uuid
  note           String?
  createdBy      String?  @map("created_by") // email
  updatedBy      String?  @map("updated_by") // email
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  assetType    AssetType          @relation(fields: [assetTypeId], references: [id], onDelete: Cascade)
  sourceTicket Ticket?            @relation("DnaRuleSourceTicket", fields: [sourceTicketId], references: [id], onDelete: SetNull)
  findings     DnaReviewFinding[]

  @@index([assetTypeId, active])
  @@map("dna_review_rules")
}

// One review run for one ticket. `usedFrames`/`frameSourceUrl`/`frameCount`/`costMicros`
// are populated once E13.2 (multimodal video review) ships; until then always false/null.
model DnaReview {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId            String   @map("ticket_id") @db.Uuid
  assetTypeId         String?  @map("asset_type_id") @db.Uuid // snapshot at review time
  model               String // provenance, e.g. claude-sonnet-5
  usedTranscript      Boolean  @default(false) @map("used_transcript")
  usedFrames          Boolean  @default(false) @map("used_frames")
  transcriptSourceUrl String?  @map("transcript_source_url")
  frameSourceUrl      String?  @map("frame_source_url")
  frameCount          Int?     @map("frame_count")
  costMicros          Int?     @map("cost_micros")
  summary             String?
  triggeredBy         String   @map("triggered_by") // 'status_change' | 'manual'
  requestedBy         String?  @map("requested_by") // email
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz

  ticket   Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  findings DnaReviewFinding[]

  @@index([ticketId, createdAt])
  @@map("dna_reviews")
}

// One finding within a review. `severity: 'flag'` is the one hard gate anywhere in this
// system — it blocks Ticket.ticketStatus -> 'Approved' in updateTicketStatus() unless
// dismissed (reaction='dismissed' + reactionNote) by someone with rule-approval
// permission. `info`/`suggestion` never block anything. `reaction` also carries the
// Tier-1 learning signal ('helpful'/'not_helpful') separate from dismissal.
model DnaReviewFinding {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewId     String    @map("review_id") @db.Uuid
  dimension    String // 'brief_compliance' | 'wording' | 'deliverable_metadata' | 'visual' | 'timing'
  note         String
  severity     String    @default("info") // info | suggestion | flag
  evidence     String? // quoted brief excerpt, or "frame at 0:06" (E13.2)
  timestampMs  Int?      @map("timestamp_ms") // set when evidence is frame/transcript-anchored (E13.2)
  ruleId       String?   @map("rule_id") @db.Uuid
  reaction     String? // null | 'helpful' | 'not_helpful' | 'dismissed'
  reactionNote String?   @map("reaction_note")
  reactedBy    String?   @map("reacted_by") // email
  reactedAt    DateTime? @map("reacted_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  review DnaReview      @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  rule   DnaReviewRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@map("dna_review_findings")
}

// ===========================================================================
// METRIC SNAPSHOTS — precomputed aggregates
// ===========================================================================

// Precomputed aggregate snapshots so dashboards read one cheap row instead of
// scanning the ~10k-row Airtable ticket table on every page load. Refreshed by
// POST /api/metrics/refresh (nightly cron). `data` holds an arbitrary payload
// keyed by `key` (e.g. "ticket_status_counts" → { total, byStatus, shipped }).
model MetricSnapshot {
  key        String   @id
  data       Json
  computedAt DateTime @updatedAt @map("computed_at")

  @@map("metric_snapshots")
}

// Per-post social performance — the "performance loop" sink. One row per
// (source, post, window, day): the numbers a published asset earned.
//
// Deliberately NOT `model Performance` (below/above in the asset section): that one is
// asset-FK'd, EAV-shaped and unused, and the thing we actually have a key for is the
// PUBLISHED URL, not an Asset row. Keys are tried most-precise first —
// platformPostId → publishedUrl → an explicit video/ticket id.
//
// Every metric is nullable on purpose. Sources disagree about what they can report
// (Meta deprecated IG `impressions` in Apr 2025, Hootsuite Perch talks impressions,
// the team logs views by hand), so we store whatever a source gives and let the read
// side show the best available rather than forcing one vocabulary.
//
// Sources: 'manual' (typed in the Studio drawer) | 'hootsuite:perch' (connector pull).
// See plans/i-got-the-mcp-temporal-summit.md.
model SocialMetric {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platformPostId   String?  @map("platform_post_id")
  publishedUrl     String?  @map("published_url") // normalized (no query/fragment/trailing slash)
  vishenVideoId    String?  @map("vishen_video_id") // VishenVideo.id when resolved (uuid or recId)
  ticketAirtableId String?  @map("ticket_airtable_id")
  channel          String?
  /**
   * Hootsuite campaign/speaker tags for this post, e.g. 'Expert to Authority Summit 2026',
   * 'Weekly Masterclass', 'Vishen', 'Regan Hillyer'.
   * Perch has always returned these inside `raw.details.tags`; we stored the payload but never
   * lifted them out. This is the mechanism the social team already groups campaigns by — Glen:
   * "on Hootsuite we tag a post depending on the campaign… MCH August 2026" — so extracting it
   * gives campaign-level grouping with no new integration.
   * Coverage is partial by nature (56 of 329 posts at 10 Sep) because it depends on the team
   * tagging as they schedule. Treat an empty array as "not tagged", never as "no campaign".
   */
  tags             String[]
  impressions      Int?
  views            Int?
  reach            Int?
  engagements      Int?
  engagementRate   Decimal? @map("engagement_rate") @db.Decimal(6, 3) // percent, e.g. 5.100
  clicks           Int?
  /**
   * The engagement breakdown, and the reason this is a mapper fix rather than a new source.
   * Perch has always returned these inside `raw.details.metrics.<platform>_metrics`:
   * `post_views` on 869 of 869 stored Instagram rows, `ig_reels_avg_watch_time` on 468.
   * None of it was ever read, because `pick()` normalises keys by stripping `_` and
   * `post_views` therefore never matched the `views` list. Retention (`avgWatchSeconds`) is
   * the one metric an editor actually controls, so its absence is what kept every readout
   * about distribution rather than craft.
   */
  saves            Int?
  shares           Int?
  comments         Int?
  likes            Int?
  avgWatchSeconds  Decimal? @map("avg_watch_seconds") @db.Decimal(8, 2) // seconds; TikTok returns 15.63
  totalWatchSeconds Int?    @map("total_watch_seconds")
  /** Platform's own shape, e.g. INSTAGRAM_REEL. Cohorts compare like with like (D105). */
  postType         String?  @map("post_type")
  /** `[{username, inviteStatus}]`. A Pending invite is a distribution fact, not an edit one. */
  collaborators    Json?
  /** Set once a Publication owns this observation (D101). Null on rows that predate it. */
  publicationId    String?  @map("publication_id") @db.Uuid
  publication      Publication? @relation(fields: [publicationId], references: [id], onDelete: SetNull)
  windowDays       Int?     @map("window_days") // 1 = 24h, 30 = last 30d, null = lifetime
  capturedAt       DateTime @map("captured_at") @db.Timestamptz
  source           String
  enteredBy        String?  @map("entered_by") // session email for manual entry
  raw              Json? // the source payload, for debugging a surprising number
  dedupeKey        String   @unique @map("dedupe_key")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([publishedUrl, capturedAt], map: "idx_social_metrics_url")
  @@index([platformPostId, capturedAt(sort: Desc)], map: "idx_social_metrics_post_capture")
  @@index([vishenVideoId, capturedAt], map: "idx_social_metrics_video")
  @@index([ticketAirtableId, capturedAt], map: "idx_social_metrics_ticket")
  @@index([tags], map: "idx_social_metrics_tags", type: Gin)
  @@index([publicationId, capturedAt(sort: Desc)], map: "idx_social_metrics_publication")
  @@map("social_metrics")
}

/**
 * Publication — the noun that was missing, and the reason `ticket_airtable_id` was set on
 * 0 of 1,642 metric rows.
 *
 * Between "we planned a post" (CommsDay) and "here are its numbers" (SocialMetric) there was
 * nothing that said *this asset went out on that account at that time*. Attribution was
 * therefore inferred on every read, by nobody, forever. A Publication is created when the
 * matcher recognises a post (D43) or when a human logs one, and everything downstream —
 * readouts, cohorts, learnings — hangs off it.
 *
 * One row per (account × platform post), never a channel array [D101]: a cross-post to
 * Facebook is its own row because Instagram reports reach, Facebook clicks and TikTok views,
 * and summing them inflates by roughly 5×. A row with no asset or ticket is legal — those are
 * the ~100 posts the social team made directly, and they stay in cohorts as peers [D45].
 */
model Publication {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /** Account handle as the platform reports it, e.g. 'mindvalley', 'mindvalley.de'. */
  accountRef     String   @map("account_ref")
  channel        String? // instagram | facebook | tiktok | youtube | linkedin
  platformPostId String?  @map("platform_post_id")
  /** Normalized permalink (`normalizeUrl`), so the same post always lands on one key. */
  publishedUrl   String?  @map("published_url")
  postType       String?  @map("post_type")
  publishedAt    DateTime? @map("published_at") @db.Timestamptz
  /** From the Social record's Content Pillar until a portal field exists [D5, D36]. */
  goal           String?
  tags           String[]
  /** Airtable recIds — the app's own ids for these arrive with the Asset reshape. */
  ticketAirtableId String? @map("ticket_airtable_id")
  socialRecordId String?  @map("social_record_id")
  vishenVideoId  String?  @map("vishen_video_id")
  /** Locale cuts and re-cuts point at their source [D109, D21]. */
  derivedFromPublicationId String? @map("derived_from_publication_id") @db.Uuid
  derivedFrom    Publication?  @relation("PublicationLineage", fields: [derivedFromPublicationId], references: [id], onDelete: SetNull)
  derivatives    Publication[] @relation("PublicationLineage")
  /** url | caption | transcript | image | manual — how this link was made [D43]. */
  linkTier       String?  @map("link_tier")
  /** When the link was established. `linkedAt − publishedAt ≤ 24h` is the 60-day target [D115]. */
  linkedAt       DateTime? @map("linked_at") @db.Timestamptz
  /** A proposed link waits for a human; readouts only go out on confirmed ones [D43, D44]. */
  confirmed      Boolean  @default(false)
  confirmedBy    String?  @map("confirmed_by")
  /** The post is gone from the platform; its last observation stays [D101]. */
  removedFromPlatformAt DateTime? @map("removed_from_platform_at") @db.Timestamptz
  metrics        SocialMetric[]
  signals        Signal[]
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([accountRef, platformPostId], map: "uq_publication_account_post")
  @@unique([accountRef, publishedUrl], map: "uq_publication_account_url")
  @@index([ticketAirtableId], map: "idx_publication_ticket")
  @@index([publishedAt(sort: Desc)], map: "idx_publication_published")
  @@index([accountRef, postType, publishedAt(sort: Desc)], map: "idx_publication_cohort")
  @@map("publications")
}

/**
 * Signal — how the team agents talk to each other, and the only way they talk [D71].
 *
 * An agent never calls another agent. It writes a typed observation onto the node it concerns,
 * with its evidence attached; other agents subscribe by kind, and every hop is visible to the
 * humans reading that item's thread. That is what makes an agent auditable rather than a
 * black box, and it is why there is no agent-to-agent RPC anywhere in this system.
 *
 * The natural key is what stops a daily check from emitting the same "shoot not filmed"
 * fifteen times in a fortnight [D103]: a re-run updates the open Signal, and a Signal whose
 * condition stops holding closes itself as `resolved`, logged as resolved-by-data.
 */
model Signal {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /** video | social | email | production | design | planning [D70]. */
  agent       String
  /** Stable id of the rule that produced it, e.g. 'gated-cta-contrast'. Part of the key. */
  checkId     String   @map("check_id")
  /** One of seven, deliberately closed [D120]: learning, anomaly, blocker, chore, watch, gap, suggestion. */
  kind        String
  lane        String?
  subjectType String   @map("subject_type") // ticket | publication | assetType | commsDay | shoot | mediaSource
  subjectId   String   @map("subject_id")
  /** Set when the subject is a publication, so readouts and signals share one join. */
  publicationId String? @map("publication_id") @db.Uuid
  publication Publication? @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  /** Bucket for periodic checks (e.g. '2026-W37'); null when the check is not periodic. */
  period      String?
  title       String
  body        String
  /** `{ refs: [...], n, delta, cohort }` — a Signal without evidence is an opinion. */
  evidence    Json?
  /** Who should act. Never Vishen: his desk is the channel, he is not paged [D92]. */
  ownerHint   String?  @map("owner_hint")
  /** open | acknowledged | dismissed | resolved. */
  status      String   @default("open")
  /** Dismissal needs a reason, and suppresses this check on this subject for 30 days [D103]. */
  dismissedReason String? @map("dismissed_reason")
  dismissedBy String?  @map("dismissed_by")
  suppressedUntil DateTime? @map("suppressed_until") @db.Timestamptz
  /** 'data' when the condition stopped holding, otherwise the email that closed it. */
  resolvedBy  String?  @map("resolved_by")
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([agent, checkId, subjectType, subjectId, period], map: "uq_signal_natural_key")
  @@index([status, kind, createdAt(sort: Desc)], map: "idx_signal_open")
  @@index([subjectType, subjectId], map: "idx_signal_subject")
  @@map("signals")
}

// The email half of the performance loop — `social_metrics` for Braze.
//
// The pack shows Perch numbers beside every social post and, until this table existed, the
// words "results live in Braze" beside every email. They live in Braze because that is the only
// place they are: the team's "24h email performance" sheet is hand-copied from the Braze UI
// (its display rounding is visible in the cells), and the Airtable 📧 Sends table that has
// exactly these columns holds four rows, all from March 2025.
//
// GRAIN IS THE CAMPAIGN, which is one email to ONE audience list. A planned email goes to six
// to eleven lists — Daily, Highlights, Weekly, Members, Coach, Events, Vishen's List, Mastery —
// and each is its own Braze campaign with its own open rate. The app rolls them up for a
// headline and keeps them apart underneath, because Daily and Members are different audiences
// and the team's own benchmarks are stated per list.
//
// `windowDays` = 2 is the honest version of "24 hours": Braze's /campaigns/data_series returns
// DAILY buckets, so the closest true figure is the send day plus the next one. Anything younger
// than 48h is still counting and the UI must say so rather than presenting a verdict.
model EmailMetric {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Braze REST campaign id. NOT the 24-hex id in the dashboard URLs the team pastes into
  /// Airtable — those are dashboard ObjectIds and the two do not convert, which is why the
  /// Airtable record is matched by subject + date rather than joined by key.
  brazeCampaignId String  @map("braze_campaign_id")
  campaignName    String  @map("campaign_name")
  subject         String?
  /// Daily | Highlights | Weekly | Members | Coach | Events | Vishen's List | Mastery — from the
  /// campaign's Braze tags, falling back to its name. Null when neither says.
  audience        String?
  /// The 📧 Emails recId, once matched. Null means no Braze campaign matched — NEVER zero results.
  emailAirtableId String? @map("email_airtable_id")
  /// How the match was made: 1.00 exact subject, 0.90 subject prefix, 0.60 name overlap.
  matchScore      Decimal? @map("match_score") @db.Decimal(3, 2)

  firstSentAt DateTime? @map("first_sent_at") @db.Timestamptz

  sent         Int?
  delivered    Int?
  uniqueOpens  Int? @map("unique_opens")
  /// Apple Mail Privacy Protection opens. Kept separate because they inflate any open rate that
  /// includes them, and a 60% OR that is half machine is a different fact from a 60% OR.
  machineOpens Int? @map("machine_opens")
  uniqueClicks Int? @map("unique_clicks")
  unsubscribes Int?
  reportedSpam Int? @map("reported_spam")
  conversions  Int?
  revenue      Decimal? @db.Decimal(12, 2)

  /// 2 = the send day plus the next (the honest "24h"); null = every bucket to date.
  windowDays Int?     @map("window_days")
  capturedAt DateTime @map("captured_at") @db.Timestamptz
  /// 'braze'. Reserved so an Iterable backfill of the 2025 sequences stays possible.
  source     String
  raw        Json?
  /// braze:<campaignId>:<window>:<captured day> — a re-run updates today's row in place.
  dedupeKey  String   @unique @map("dedupe_key")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([emailAirtableId, capturedAt(sort: Desc)], map: "idx_email_metrics_email")
  @@index([brazeCampaignId, capturedAt(sort: Desc)], map: "idx_email_metrics_campaign")
  @@index([firstSentAt], map: "idx_email_metrics_sent")
  @@map("email_metrics")
}

// Small key→value store for sync watermarks (e.g. the ticket inbound-pull cursor:
// the newest Airtable "Last Modified" time we've imported). Keeps the two-way pull
// incremental instead of rescanning the whole table each cycle.
// OAuth credentials for third-party integrations the APP holds on its own behalf (as
// opposed to a per-user login). One row per provider, e.g. 'hootsuite'.
//
// Why the app holds a token at all: the performance loop needs to pull numbers on a
// schedule, and a Claude/claude.ai connector only works inside a session someone starts.
// Hootsuite's Perch resource advertises the `offline` scope, so a single human consent
// yields a refresh token the cron can keep using. See plans/i-got-the-mcp-temporal-summit.md.
//
// Secrets are stored SEALED (AES-256-GCM, lib/crypto/secret-box.ts) — never plaintext. The
// client id/secret come from dynamic client registration, so no one has to hand-register an
// OAuth app in the provider's console.
model ExternalCredential {
  provider        String    @id
  clientId        String?   @map("client_id")
  clientSecretEnc String?   @map("client_secret_enc")
  accessTokenEnc  String?   @map("access_token_enc")
  refreshTokenEnc String?   @map("refresh_token_enc")
  /**
   * When the ACCESS token expires; the refresh token outlives it.
   */
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz
  scope           String?
  /**
   * Free-text note for the admin surface, e.g. the last refresh failure.
   */
  lastError       String?   @map("last_error")
  connectedBy     String?   @map("connected_by")
  connectedAt     DateTime? @map("connected_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("external_credentials")
}

model SyncState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("sync_state")
}

// ===========================================================================
// MESSAGE OF THE WEEK (E-MOW) — migration 0024_mow
//
// The Monday 08:00 MYT pack: one weekly record per brand holding the message, the goal, one
// committed smart number, and the day-by-day slots with named owners and learnings.
//
// Plan:  plans/ref-to-sep-call-zazzy-moth.md   (decisions S1–S21 override the brief)
// Brief: Sep Calls/Handoff/MOW-HANDOFF.md      (D1–D9, data model, jobs, views)
//
// Two principles this section must not break:
//  1. PROPOSE-ONLY. Every narrative field is a staged/committed PAIR. AI writes `*Staged`;
//     a named human commits into `*Committed`; downstream reads ONLY the committed value.
//     This is Glen's condition — "if efficiency is a recommendation and that's not true, it
//     might derail everything." Copies the DnaReview* / ClipRule pattern; do not invent a second.
//  2. ONE HEADLINE NUMBER. `smartNumber` is a single Json object, never an array. The other
//     candidate metrics live in `drivers` and render smaller. See S1's guardrail in the plan.
// ===========================================================================

// 🗓️ Comms Calendar (COMMS_DAY, tblUUVMKdSrLVhTx8) — one row per DATE. The upstream for MowSlot
// and the answer to "what went out on 2 September".
//
// TWO-WAY (S8): PG is system-of-record, writes enqueue an AirtableOutbox row and drain via
// lib/airtable/drain-after.ts, with echo-suppression on airtablePushedAt — but ONLY over the
// writable subset. Airtable rejects writes to formula/rollup/lookup/createdTime/lastModifiedTime,
// which is 31 of this table's 75 fields, so the `ro*` columns below are mirror-for-display and
// must never appear in the push map. Surface that in the UI so a refused write doesn't read as a
// sync bug.
//
// Link fields are kept as Airtable recId arrays (same convention as MediaSource) rather than
// modelled as relations — the linked tables are mostly unsynced.
model CommsDay {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  airtableId    String?   @unique @map("airtable_id")
  date          DateTime? @db.Date // ← "Date"; the row's identity, one per day
  messageOfWeek String?   @map("message_of_week") // ← plain text today; becomes a link post-workshop
  theGoal       String?   @map("the_goal") // ← plain text today, same
  phase         String?
  coreMessage   Boolean   @default(false) @map("core_message")
  internalNote  String?   @map("internal_note")
  score         String?
  campaignType  String?   @map("campaign_type")
  noOfEmails    Int?      @map("no_of_emails")

  // Actuals the day-cards read.
  landingPageSessions Int?     @map("landing_page_sessions")
  sublist             Int?
  attendees           Int?
  spSessions          Int?     @map("sp_sessions")
  sales               Int?
  totalDailyRevenue   Decimal? @map("total_daily_revenue") @db.Decimal(14, 2)

  // Airtable link fields, stored as recId arrays.
  officialCalIds  String[] @map("official_cal_ids") // → 📅 Official Cal; presence ⇒ a campaign is live that day (drives S2's leads default)
  initiativeIds   String[] @map("initiative_ids")
  emailIds        String[] @map("email_ids")
  socialAssetIds  String[] @map("social_asset_ids")
  bannerIds       String[] @map("banner_ids")
  notificationIds String[] @map("notification_ids")
  blogIds         String[] @map("blog_ids")

  // READ-ONLY mirror (formula/lookup upstream). Never written back.
  roLeadGenGoal   Decimal? @map("ro_lead_gen_goal") @db.Decimal(14, 2) // ← lookup: the campaign's lead target
  roTargetRevenue Decimal? @map("ro_target_revenue") @db.Decimal(14, 2)
  roProjectName   String?  @map("ro_project_name")
  roStatus        String?  @map("ro_status")
  roWeekday       String?  @map("ro_weekday")
  roNameOfComms   String?  @map("ro_name_of_comms")

  airtablePushedAt DateTime? @map("airtable_pushed_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  syncedAt         DateTime  @default(now()) @map("synced_at") @db.Timestamptz

  slots MowSlot[]

  @@index([date], map: "idx_comms_days_date")
  @@index([airtablePushedAt], map: "idx_comms_days_pushed")
  @@map("comms_days")
}

// 🗓️ Message of the Week master (MESSAGE_OF_WEEK, tbl3NPxLDApiIyobS).
//
// Repointed 10 Sep (plan §0 / V3): the master is the table the 9 Sep notes called
// "Message of the week copy" and said to delete. `tblrxLMH2ncoLaHO5` is the superseded one.
//
// `brand` is a SINGLE value, not a set — the 10 Sep workshop settled it as one row per brand per
// week, which is what MowWeek's (weekStart, brand) key already assumed. Live values include the
// misspelling 'Mindalley' on 6 of 7 records; it is NOT normalised here (reference data is
// read-only in the app — the fix is in Airtable + a reconcile). See MESSAGE_OF_WEEK.brandValues.
//
// `weekStarting` does not exist upstream yet. Until it does the week is DERIVED from the
// message's linked dates (MV via the comms-calendar link, VL via the Live Date lookup), so this
// column stays nullable and readers must tolerate null.
model MessageOfWeek {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  airtableId   String?   @unique @map("airtable_id")
  mow          String? // ← "MOW" (primary)
  keyMessage   String?   @map("key_message")
  goal         String? // richText upstream; EMPTY on all 6 real records as of 10 Sep
  brand        String? // SINGLE select upstream: 'Mindalley' [sic] | 'VL'
  weekStarting DateTime? @map("week_starting") @db.Date // not upstream yet — derived meanwhile
  active       Boolean   @default(true)
  companyGoals String?   @map("company_goals")
  assigneeName String?   @map("assignee_name")

  // 🗓️ Comms Calendar link, as Airtable recIds. This is how an MV message's WEEK is derived
  // before `Week starting` exists (V2): resolve these against `comms_days.airtable_id` to get
  // real dates. Stored as ids rather than dates because the REST layer returns link fields as
  // recIds (returnFieldsByFieldId=true) — the display names that read "September 8, 2026" are
  // only available through the MCP, which the app cannot call.
  //
  // VL messages have no comms-calendar link; their dates live on the VL base's Videos link, which
  // the comms-calendar read path resolves. So a VL week stays underivable here until either that
  // path lands or `Week starting` is populated.
  commsCalendarIds String[] @map("comms_calendar_ids")

  airtablePushedAt DateTime? @map("airtable_pushed_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  syncedAt         DateTime  @default(now()) @map("synced_at") @db.Timestamptz

  weeks MowWeek[]

  @@index([weekStarting], map: "idx_mow_week_starting")
  @@index([airtablePushedAt], map: "idx_mow_pushed")
  @@map("messages_of_week")
}

// One weekly record PER BRAND (S3 — overrides the brief's "default one"). MV and VL each get
// their own message, goal and smart number; a third brand is simply another row.
model MowWeek {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  weekStart DateTime @map("week_start") @db.Date // Monday
  brand     String // 'MV' | 'VL' | … — part of the identity, not a tag
  status    String   @default("draft") // draft | set | closed

  messageOfWeekId String?        @map("message_of_week_id") @db.Uuid
  messageOfWeek   MessageOfWeek? @relation(fields: [messageOfWeekId], references: [id], onDelete: SetNull)

  // The message + goal as committed for this brand-week (denormalized from MessageOfWeek so a
  // closed week keeps what it actually said, even if the master row is later edited).
  message String?
  goal    String?

  // THE one headline number. A single object — never an array. Shape:
  //   { key: 'revenue'|'leads'|'active_users', label, value, target, source, asOf }
  // `source` records the provenance path (e.g. 'session:metabase' vs 'app:metabase') so the
  // Metabase swap in plan §2 is invisible to the page. Staged until a human commits.
  smartNumberStaged    Json?   @map("smart_number_staged")
  smartNumberCommitted Json?   @map("smart_number_committed")
  // Which metric is the headline this week (S1/S2). Campaign weeks default to 'leads' against
  // the campaign's own lead goal (CommsDay.roLeadGenGoal); otherwise from the primary Offer.
  smartNumberKey       String? @map("smart_number_key")
  // The other candidate metrics, demoted — rendered smaller, never promoted automatically.
  drivers              Json?

  primaryOfferId String? @map("primary_offer_id") @db.Uuid
  primaryOffer   Offer?  @relation(fields: [primaryOfferId], references: [id], onDelete: SetNull)

  weekSummaryStaged    String? @map("week_summary_staged")
  weekSummaryCommitted String? @map("week_summary_committed")

  // Any of Gareth, Glen or Ramya may commit (S4) — enforced by an allowlist in code, and shown
  // on the page so the room knows whose numbers these are.
  committedBy String?   @map("committed_by")
  committedAt DateTime? @map("committed_at") @db.Timestamptz
  generatedAt DateTime? @map("generated_at") @db.Timestamptz

  airtablePushedAt DateTime? @map("airtable_pushed_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  slots       MowSlot[]
  learnings   Learning[]
  briefs      Brief[]
  experiments Experiment[]

  @@unique([weekStart, brand], map: "uq_mow_weeks_week_brand")
  @@index([weekStart], map: "idx_mow_weeks_start")
  @@map("mow_weeks")
}

// One row per (day × channel). Email and social on the same day are SEPARATE rows and are
// intentionally different messages — per the brief, do not treat that as misalignment. What must
// be shared is the destination (Offer).
model MowSlot {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  weekId String  @map("week_id") @db.Uuid
  week   MowWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)

  day               DateTime  @db.Date
  channel           String // email | social | platform
  brand             String?
  // Platform comms (Sadaf) attach to the WEEK, not a day — they run >= 7 days. Those rows carry
  // channel='platform' and the week's Monday as `day` (it is NOT NULL, so there is no "no day"
  // sentinel). No source exists yet, so they render as a labelled empty state and nobody types
  // anything (S17).
  expectedAssetType String?   @map("expected_asset_type")
  ownerEmployeeId   String?   @map("owner_employee_id") @db.Uuid
  ownerEmployee     Employee? @relation(fields: [ownerEmployeeId], references: [id], onDelete: SetNull)
  ownerNameFallback String?   @map("owner_name_fallback") // e.g. "Editor TBC" where the transcript is unverified

  plannedFromSource String? @map("planned_from_source") // 'comms_calendar' | 'release_planner' | 'manual'

  // 'blocked' (upstream, e.g. no speaker list) is NOT 'missed' (we just didn't ship it).
  // Two statuses, two colours — the brief is explicit about this.
  status      String  @default("planned") // planned | shipped | missed | blocked
  blockerNote String? @map("blocker_note")

  commsDayId String?   @map("comms_day_id") @db.Uuid
  commsDay   CommsDay? @relation(fields: [commsDayId], references: [id], onDelete: SetNull)

  offerId String? @map("offer_id") @db.Uuid
  offer   Offer?  @relation(fields: [offerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  snapshots AssetPerformanceSnapshot[]
  learnings Learning[]
  briefs    Brief[]

  @@index([weekId, day], map: "idx_mow_slots_week_day")
  @@index([day, channel], map: "idx_mow_slots_day_channel")
  @@map("mow_slots")
}

// A destination / offer — the thing assets point at, and the level at which the smart number is
// actually true (brief D3). Inferred from parsed UTMs, not entered by hand (brief D2).
model Offer {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  path         String // e.g. /summit/expert
  canonicalUrl String? @map("canonical_url")
  name         String?

  utmCampaignPattern    String? @map("utm_campaign_pattern") // e.g. launch_eas_sep_2026
  // Which metric this offer is judged on; supplies MowWeek's default headline outside campaign
  // weeks. 'revenue' | 'leads' | 'active_users'.
  smartNumberDefinition String? @map("smart_number_definition")
  // Curated Metabase question id. HARD-ALLOWLISTED in code to 31846 (leads) / 32044 (revenue) —
  // never point a generator at the full dashboard: Glen's did, and "it would just make shit up
  // after every two days, it would fake the revenue".
  metabaseQueryRef      String? @map("metabase_query_ref")
  // Rafi's "Funnels & Experimentations" scoreboard row. Link out, don't rebuild (brief D6).
  airtableTestRecordId  String? @map("airtable_test_record_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  slots            MowSlot[]
  weeks            MowWeek[]
  destinationLinks DestinationLink[]
  snapshots        AssetPerformanceSnapshot[]
  creativeRecords  CreativeRecord[]

  @@unique([path], map: "uq_offers_path")
  @@map("offers")
}

// The output of destination inference, and the human-link queue for what it couldn't match
// (brief D2). One row per observed link on a send / post / banner / test.
//
// Resolves to WHICH OFFER, not which post. Getting to per-post needs utm_content unique per post
// — an Airtable formula on the 📣 Social row (S7, plan §3). Today utm_content carries only 30
// distinct placement values, so ten reels in one campaign are indistinguishable.
model DestinationLink {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceType String  @map("source_type") // braze_send | social_post | banner | test
  sourceId   String  @map("source_id") // Airtable recId or PG id of the originating row
  rawUrl     String  @map("raw_url")
  parsedUtm  Json?   @map("parsed_utm") // { source, medium, campaign, content, term }
  offerId    String? @map("offer_id") @db.Uuid
  offer      Offer?  @relation(fields: [offerId], references: [id], onDelete: SetNull)

  matchConfidence Decimal?  @map("match_confidence") @db.Decimal(4, 3)
  humanLinkedBy   String?   @map("human_linked_by")
  humanLinkedAt   DateTime? @map("human_linked_at") @db.Timestamptz
  // True when the CTA runs through ManyChat DM rather than a clickable link: attribution there is
  // campaign-level at best, so the UI labels it that way instead of showing a blank (plan §3).
  viaManychat     Boolean   @default(false) @map("via_manychat")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([sourceType, sourceId, rawUrl], map: "uq_destination_links_source_url")
  @@index([offerId], map: "idx_destination_links_offer")
  @@map("destination_links")
}

// SNAPSHOTS, not a mutable current value — revenue backfills upward as late attribution lands,
// so a figure is never final and the page must show "as of".
model AssetPerformanceSnapshot {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId String?  @map("ticket_id") @db.Uuid
  ticket   Ticket?  @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  slotId   String?  @map("slot_id") @db.Uuid
  slot     MowSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  offerId  String?  @map("offer_id") @db.Uuid
  offer    Offer?   @relation(fields: [offerId], references: [id], onDelete: SetNull)

  channel     String?
  publishedAt DateTime? @map("published_at") @db.Timestamptz
  snapshotAt  DateTime  @default(now()) @map("snapshot_at") @db.Timestamptz
  horizon     String // 24h | 7d | 30d — Rafi's rule: nothing is read early
  // Whatever the source gave us. Sources disagree about what they can report, so we store the
  // payload and let the read side show the best available rather than forcing one vocabulary.
  metrics     Json

  source String // hootsuite:perch | youtube | braze | airtable:sends | manual

  attributions PerformanceAttribution[]

  @@index([ticketId, snapshotAt], map: "idx_aps_ticket")
  @@index([slotId, horizon], map: "idx_aps_slot_horizon")
  @@map("asset_performance_snapshots")
}

// Performance decomposes to lever → owner: retention → editor, thumbnail CTR → packaging owner,
// destination click-through → message owner (brief D5).
//
// MANUAL for 14 Sep (S16) — a human types the owner. Structuring it now means the eventual E10
// sub-task model backfills into a real column instead of migrating free text.
model PerformanceAttribution {
  id         String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  snapshotId String                   @map("snapshot_id") @db.Uuid
  snapshot   AssetPerformanceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  lever             String // retention | packaging | message
  ownerEmployeeId   String?   @map("owner_employee_id") @db.Uuid
  ownerEmployee     Employee? @relation(fields: [ownerEmployeeId], references: [id], onDelete: SetNull)
  ownerNameFallback String?   @map("owner_name_fallback")
  note              String?
  enteredBy         String?   @map("entered_by")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([snapshotId], map: "idx_perf_attr_snapshot")
  @@map("performance_attributions")
}

// Gareth's tabular data: every asset stored with its copy, transcript, hook, offer and CTA, so
// the system becomes a learning engine and not just a storage engine. Backfill Ramya's
// newsletter archive first. Phase 2 — the table lands now so there's no second migration.
model CreativeRecord {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId String? @map("ticket_id") @db.Uuid
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  offerId  String? @map("offer_id") @db.Uuid
  offer    Offer?  @relation(fields: [offerId], references: [id], onDelete: SetNull)

  assetType    String? @map("asset_type")
  copy         String?
  transcript   String?
  hook         String?
  cta          String?
  thumbnailRef String? @map("thumbnail_ref")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([ticketId], map: "idx_creative_records_ticket")
  @@map("creative_records")
}

// <= 5 COMMITTED learnings per week, each attributed to the person who controls the lever.
// The library is read by the agent, not browsed (brief D7) — the page is the evidence trail.
model Learning {
  id     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  weekId String   @map("week_id") @db.Uuid
  week   MowWeek  @relation(fields: [weekId], references: [id], onDelete: Cascade)
  slotId String?  @map("slot_id") @db.Uuid
  slot   MowSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)

  textStaged    String? @map("text_staged")
  textCommitted String? @map("text_committed")

  /// True when the SYSTEM drafted this line rather than a person (AA2). Surfaced in the UI so an
  /// AI suggestion never reads as a colleague's judgement; editing one clears the flag, because a
  /// human has then put their name behind the words.
  proposed Boolean @default(false)

  /// The lever this learning points at, and who owns it — free text for 14 Sep (S16).
  /// `leverOwnerEmployee` below is the real link, and wins when both are set.
  leverOwner String? @map("lever_owner")

  leverOwnerEmployeeId String?   @map("lever_owner_employee_id") @db.Uuid
  leverOwnerEmployee   Employee? @relation(fields: [leverOwnerEmployeeId], references: [id], onDelete: SetNull)

  rank        Int? // display order within the week's <= 5
  committedBy String?   @map("committed_by")
  committedAt DateTime? @map("committed_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  appliedToBriefs Brief[]

  @@index([weekId, rank], map: "idx_learnings_week_rank")
  @@map("learnings")
}

// The pack is mostly briefs: one per slot owner, drafted from last week's evidence, committed by
// a human. Editors also declare what they will improve in the next upload — Glen's specific ask.
model Brief {
  id     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  weekId String   @map("week_id") @db.Uuid
  week   MowWeek  @relation(fields: [weekId], references: [id], onDelete: Cascade)
  slotId String?  @map("slot_id") @db.Uuid
  slot   MowSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)

  ownerEmployeeId String?   @map("owner_employee_id") @db.Uuid
  ownerEmployee   Employee? @relation(fields: [ownerEmployeeId], references: [id], onDelete: SetNull)
  ownerEmail      String?   @map("owner_email") // who may edit this block

  textStaged    String? @map("text_staged")
  textCommitted String? @map("text_committed")

  /// True when the SYSTEM drafted this line rather than a person (AA2). Surfaced in the UI so an
  /// AI suggestion never reads as a colleague's judgement; editing one clears the flag, because a
  /// human has then put their name behind the words.
  proposed Boolean @default(false)

  /// The lever this learning points at, and who owns it — free text for 14 Sep (S16).
  /// `leverOwnerEmployee` below is the real link, and wins when both are set.
  leverOwner      String? @map("lever_owner")
  // "What am I improving in my next upload?" — one key point, owner's own words.
  nextUploadFocus String? @map("next_upload_focus")

  evidence Json? // learning ids + snapshot ids the draft was built from

  committedBy String?   @map("committed_by")
  committedAt DateTime? @map("committed_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  learnings Learning[]

  @@index([weekId], map: "idx_briefs_week")
  @@index([ownerEmail], map: "idx_briefs_owner")
  @@map("briefs")
}

// CONTENT experiments only — hooks, thumbnails, formats, messaging (brief D6). Funnel and page
// tests are Rafi's; link out to his scoreboard via the shared Offer, don't rebuild them.
model Experiment {
  id     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  weekId String?  @map("week_id") @db.Uuid
  week   MowWeek? @relation(fields: [weekId], references: [id], onDelete: SetNull)

  hypothesis String
  evidence   Json?
  scope      String @default("content") // content only

  ownerEmployeeId String?   @map("owner_employee_id") @db.Uuid
  ownerEmployee   Employee? @relation(fields: [ownerEmployeeId], references: [id], onDelete: SetNull)

  status  String    @default("proposed") // proposed | open | closed
  opensAt DateTime? @map("opens_at") @db.Date
  // Rafi's rule: nothing is read early. Enforce >= 7 days after opensAt.
  readsAt DateTime? @map("reads_at") @db.Date
  result  String?

  linkedAirtableTestId String? @map("linked_airtable_test_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status, readsAt], map: "idx_experiments_status_reads")
  @@map("experiments")
}
