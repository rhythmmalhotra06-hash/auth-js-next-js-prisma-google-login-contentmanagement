# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# Airtable raw schema dumps (bulky + regenerable via context/export-airtable-schema.js; summaries are committed)
Context/airtable-schema/*.raw.json

# ── Meeting source material (added 2026-09-10) ───────────────────────────────
# Gemini transcripts, recordings and handoff bundles. Kept out of git for two reasons:
# they are ~40MB of .docx/.zip/.pdf, and they carry verbatim meeting content about named
# people. The plan file references them by path; they live on the build machine.
Sep Calls/
Calls Aug/
Clip Cover Generator/
AutoEditingAgent*.zip
.shotkit/

# ── Generated design-canvas output ───────────────────────────────────────────
# The .dc.html artboards, canvas.json and build-export.mjs ARE source and are committed.
# These two are produced from them (2.5MB seeded payload + the flattened export), so they
# are regenerated rather than tracked — see Context/mockups/mow-canvas/build-export.mjs.
Context/mockups/mow-canvas/message-of-the-week.html
Context/mockups/mow-canvas/export/

# File-sync duplicates. This repo lives in a synced folder, and the sync client resolves
# conflicts by writing "name 2.ext" / "name 3.ext" next to the original. Thirty of them had been
# committed by 10 Sep, including one inside app/ and five under tests/ — the test runner globbed
# the copies and ran every suite twice, and a migration runner globbing loosely would have applied
# some migrations twice. They are never intentional.
*\ [0-9].ts
*\ [0-9].tsx
*\ [0-9].mts
*\ [0-9].sql
*\ [0-9].json
*\ [0-9].md
