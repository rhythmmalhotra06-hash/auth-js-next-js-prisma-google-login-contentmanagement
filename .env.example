DATABASE_URL=""

# Google OAuth (Auth.js provider)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Auth.js session secret (generate: openssl rand -base64 33)
AUTH_SECRET=""
# Required on non-Vercel hosts (local custom port, Cloud Run)
AUTH_TRUST_HOST="true"

# Airtable personal access token.
#   read-only (reference sync, live intake reads): schema.bases:read, data.records:read
#   two-way ticket push (Phase 2): ALSO needs data.records:write
AIRTABLE_TOKEN=""

# Bearer secret for the POST /api/sync/* routes (reference, push, …)
SYNC_SECRET=""

# Braze REST key for the email half of the performance loop (email_metrics).
# MUST carry campaigns.list + campaigns.details + campaigns.data_series — Braze keys cannot be
# edited after creation, only deleted and recreated, so all three have to be on it from the start.
# Without it /api/metrics/braze-pull is a no-op and every email row reads "no campaign matched".
BRAZE_API_KEY=""
# Per-cluster REST host. Ours is iad-01; the dashboard hostname is NOT the REST one.
BRAZE_REST_ENDPOINT="https://rest.iad-01.braze.com"

# Two-way ticket PUSH (portal → Airtable). Leave unset/false until the 0006 migration
# is applied AND AIRTABLE_TOKEN has data.records:write. When "true", ticket writes
# enqueue an outbox row and POST /api/sync/push drains it to Airtable.
AIRTABLE_PUSH_ENABLED="false"

# Anthropic API key for the Content Clipping Engine (E8) and DNA review (E13).
# Deploy: set with `kessel env secret ANTHROPIC_API_KEY=...` before `kessel deploy`.
ANTHROPIC_API_KEY=""

# Base URL of the render-service Cloud Run service (E12.2 Remotion renderer; E13.2 also
# calls its POST /extract-frames for DNA video review). Local dev: run render-service on
# :8080 (`cd render-service && node server.mjs`) and set http://localhost:8080.
# Deploy: set with `kessel env set RENDER_SERVICE_URL=...` to that service's Kessel URL.
RENDER_SERVICE_URL=""

# Bearer secret render-service requires on POST /render and /extract-frames. render-service
# is public Cloud Run access (IAP blocked legitimate calls from this app with no available
# fix) — this secret is what actually protects it. Must match the SAME value set on
# render-service's own RENDER_SERVICE_SECRET (set independently in each project's env —
# they are two separate Kessel projects). Generate: openssl rand -base64 32.
RENDER_SERVICE_SECRET=""

# Dropbox folder resolution for DNA visual review (E13.2). 28% of tickets link only a
# Dropbox FOLDER, whose only no-auth download form is a .zip of the whole folder (measured
# at 1.47GB) — which used to reach ffprobe as "moov atom not found". With these set,
# render-service lists the shared folder and downloads the best video inside it instead.
#
# NOTE: these belong to the render-service Kessel project, NOT the portal — that service
# is the only component that downloads video. Set them there:
#   cd render-service && kessel env secret DROPBOX_APP_KEY=... DROPBOX_APP_SECRET=... DROPBOX_REFRESH_TOKEN=...
#
# Setup: create an app at dropbox.com/developers/apps (scoped access, full Dropbox) with
# scopes `files.metadata.read` + `sharing.read`, then authorize ONCE with
# token_access_type=offline as an account that can see the team's files and exchange the
# code for a refresh token. A key/secret pair alone is not enough: files/list_folder
# permits user auth only (sharing/get_shared_link_file would accept app auth, but we need
# the listing to know which file to fetch).
#
# Unset is a supported state — render-service returns dropbox_folder_unconfigured and the
# ticket panel falls back to its paste-a-direct-link box.
DROPBOX_APP_KEY=""
DROPBOX_APP_SECRET=""
DROPBOX_REFRESH_TOKEN=""

# Vishen media → clip pipeline. Auto-detect (POST /api/media/discover) polls Vishen's
# YouTube channel uploads and adds New inbox rows (deduped on URL); clip generation
# stays button-triggered. Channel youtube.com/user/vishenlakhiani → UCgAvK6yXl3BtasS9mS0kefQ.
#   kessel env secret YOUTUBE_API_KEY=...         (YouTube Data API v3 key)
#   kessel env set    VISHEN_YT_CHANNEL_ID=UC...  (plain)
#   kessel env secret DISCOVER_SHARED_SECRET=...  (cron also sends it as the x-discover-secret header)
YOUTUBE_API_KEY=""
VISHEN_YT_CHANNEL_ID="UCgAvK6yXl3BtasS9mS0kefQ"
DISCOVER_SHARED_SECRET=""

# Supadata transcript API — primary auto-transcribe path. Runs its own residential
# proxies + AI fallback, so it works from the Cloud Run datacenter IP where YouTube
# blocks youtubei.js. When unset, transcript fetch falls back to best-effort
# youtubei.js (works locally; usually blocked when deployed) and to pasted transcripts.
#   kessel env secret SUPADATA_API_KEY=...  before `kessel deploy`
# Get a key at https://supadata.ai (free tier ~100 transcripts/mo).
SUPADATA_API_KEY=""

# Two-way sync with Vishen's content base (Major Videos/Clips ⇆ Media Sources/Clip Suggestions).
# OUTBOUND (portal → Vishen's base) lives in app code and is on by default; set to "false" to
# disable all portal→Vishen writes. INBOUND (Vishen → portal) is handled by Airtable Automations,
# not env — see docs/airtable-automations/. Cutoff for the one-way backstop sync below.
VISHEN_SYNC_ENABLED="true"
MAJOR_VIDEOS_SYNC_AFTER="2026-06-30"

# Slack intake (Phase 2). POST /api/media/slack-scan reads a channel for shared
# YouTube links and adds them to the inbox (Submitted Via "Slack"). Outbound-only
# (the app is IAP-gated, so inbound Slack webhooks are blocked). Bot needs
# channels:history / groups:history and must be a member of the channel.
SLACK_BOT_TOKEN=""
SLACK_MEDIA_CHANNEL_ID=""

# BlinkLife push (portal → BlinkLife editor tasks / Vishen review / brief memories).
# Mirror of the Airtable outbox. Leave disabled until the 0007 migration is applied
# AND a token is set; when "true", ticket writes enqueue a row and
# POST /api/push/blinklife drains it via the BlinkLife MCP API.
BLINKLIFE_ENABLED="false"
BLINKLIFE_TOKEN=""                                    # personal MCP bearer token (single shared account for now)
BLINKLIFE_MCP_URL="https://api.blinklife.com/api/v1/mcp"
BLINKLIFE_PROJECT_NAME="Content Production"           # shared project tickets mirror into
BLINKLIFE_SYNC_SECRET=""                              # bearer for POST /api/push/blinklife (falls back to SYNC_SECRET)
# Absolute portal base URL, embedded as a deep link in each BlinkLife task.
APP_BASE_URL=""
